<https://mbdiaries.itatti.harvard.edu/resource/diary/1916/page/227> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "227"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1916/page/227/production> ;
