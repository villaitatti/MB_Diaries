<https://mbdiaries.itatti.harvard.edu/resource/diary/1907/page/37> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "37"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1907/page/37/production> ;
