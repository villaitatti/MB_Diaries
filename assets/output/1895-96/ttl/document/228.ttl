<https://mbdiaries.itatti.harvard.edu/resource/diary/1895-96/page/228> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "228"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1895-96/page/228/production> ;
