<https://mbdiaries.itatti.harvard.edu/resource/diary/1899-02/page/181> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "181"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1899-02/page/181/production> ;
