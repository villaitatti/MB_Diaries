<https://mbdiaries.itatti.harvard.edu/resource/diary/1903-04/page/197> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "197"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1903-04/page/197/production> ;
