<https://mbdiaries.itatti.harvard.edu/resource/diary/1903-04/page/25> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "25"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1903-04/page/25/production> ;
