<https://mbdiaries.itatti.harvard.edu/resource/diary/1902-03/page/124> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "124"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1902-03/page/124/production> ;
