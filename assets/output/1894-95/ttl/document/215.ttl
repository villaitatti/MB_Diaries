<https://mbdiaries.itatti.harvard.edu/resource/diary/1894-95/page/215> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "215"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1894-95/page/215/production> ;
