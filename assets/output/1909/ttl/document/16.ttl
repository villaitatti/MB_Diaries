<https://mbdiaries.itatti.harvard.edu/resource/diary/1909/page/16> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "16"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1909/page/16/production> ;
