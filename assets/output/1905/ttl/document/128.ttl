<https://mbdiaries.itatti.harvard.edu/resource/diary/1905/page/128> a crm:E22_Man-Made_Object,
        mbdiaries-ontology:Page ;
    rdfs:label "128"^^xsd:string ;
    crm:P108i_was_produced_by <https://mbdiaries.itatti.harvard.edu/diary/1905/page/128/production> ;
